root = true

[*.{cs,csx}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Nullable / analyzers: local == CI (sprint S1)
# Style rules stay at suggestion level: compiler warnings fail the build
# (TreatWarningsAsErrors), style does not.
dotnet_style_require_accessibility_modifiers = always:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_prefer_braces = true:suggestion
dotnet_sort_system_directives_first = true:suggestion
dotnet_style_parentheses_in_conditional_expression = always_for_clarity:suggestion

[*.{props,targets,csproj,slnx,xml,md,yml,yaml,ps1}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
