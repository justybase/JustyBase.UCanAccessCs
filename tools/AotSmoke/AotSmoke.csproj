<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UCanAccess.Tools.AotSmoke</RootNamespace>
    <Description>NativeAOT/trim smoke host for JustyBase.UCanAccessCs (CI only, not packed).</Description>
    <IsPackable>false</IsPackable>
    <!-- PublishAot is enabled by CI (-p:PublishAot=true), never by default,
         so a plain `dotnet build` stays JIT-fast and needs no native toolchain. -->
    <!-- IL2104 (transitive Superpower via JustyBase.NetezzaSqlParser produces
         trim warnings) is downgraded to a warning for this smoke host only:
         the dependency is external and cannot be annotated from here; the
         published native binary is instead verified at runtime by Program.cs.
         Own assemblies (UCanAccess/UCanAccess.File/UCanAccess.AccessCrypto)
         must stay trim-warning-free. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UCanAccess\UCanAccess.csproj" />
    <ProjectReference Include="..\..\src\UCanAccess.File\UCanAccess.File.csproj" />
    <ProjectReference Include="..\..\src\UCanAccess.AccessCrypto\UCanAccess.AccessCrypto.csproj" />
  </ItemGroup>

</Project>
