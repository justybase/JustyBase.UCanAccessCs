<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>UCanAccess</RootNamespace>
    <PackageId>JustyBase.UCanAccessCs</PackageId>
    <PackageTags>access mdb accdb ado.net jet jackcess ucanaccess sqlite</PackageTags>
    <IsPackable>true</IsPackable>
    <!-- NativeAOT/trim contract for consumers (TrimMode=partial): the
         assembly is annotated and smoke-tested for PublishAot
         (see tools/AotSmoke + CI job `aot-smoke`). -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UCanAccess.File\UCanAccess.File.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UCanAccess.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\images\ucanaccess-csharp-logo-200.png" Pack="true" PackagePath="docs\images\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JustyBase.NetezzaSqlParser" Version="$(JustyBaseParserVersion)" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

</Project>
